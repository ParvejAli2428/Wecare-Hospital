rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // OPD Appointment records (Patient bookings, walk-ins, and Admin management)
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }
  }
}

